# GB300 (Grace Blackwell Ultra, sm_103), linux/arm64, CUDA 13.0 (matches the cuda13-gb300 ISO).
# Only values that differ between scenarios are set here; the rest are Dockerfile defaults.
# An environment variable of the same name overrides a value at build time.
PLATFORM=linux/arm64
BASE_BUILD_IMAGE=nvidia/cuda:13.0.2-devel-ubuntu24.04
BASE_RUNTIME_IMAGE=nvidia/cuda:13.0.2-runtime-ubuntu24.04
NIXL_REF=v1.5.2
NIXL_PLUGINS=UCX,LIBFABRIC,GDS,GDS_MT,POSIX
NIXL_CUDA_ARCH=103
